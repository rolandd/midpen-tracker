{
	"extends": "$app/tsconfig",
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"strict": true,
		"types": ["node", "$app/types"]
	}
	// `#lib` resolves through the "imports" map in package.json (SvelteKit 3
	// dropped the `$lib` alias). Subpath imports need explicit extensions.
}
