{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"prebuild": "node ../scripts/generate-security-config.js",
		"predev": "node ../scripts/generate-security-config.js",
		"dev": "vite dev",
		"build": "vite build",
		"build:e2e": "PUBLIC_DEMO_MODE=true PUBLIC_BASE_URL=http://127.0.0.1:4173 PUBLIC_API_URL=http://127.0.0.1:8080 pnpm build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"format": "prettier --write .",
		"check-format": "prettier --check .",
		"test": "pnpm test:unit",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:build": "node scripts/verify-build.mjs",
		"test:e2e": "pnpm build:e2e && playwright test",
		"verify": "pnpm check && pnpm lint && pnpm check-format && pnpm test:unit && PUBLIC_BASE_URL=https://example.com PUBLIC_API_URL=https://api.example.com pnpm build && pnpm test:build"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260702.1",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.64.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^25.9.9",
		"autoprefixer": "^10.6.1",
		"eslint": "^9.39.5",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^7.3.7",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"svelte-switcher": "^1.0.2"
	}
}
